/**
 * 全站样式。色值和 web 版 src/styles.css 里的 token 一一对应，别改单边。
 * 规矩照搬设计规范：8px 刻度、3 种圆角、零阴影、字重只有两档。
 * 单位用 rpx（750rpx = 屏宽），这样手机上不用再算。
 */

page {
  --bg: #0e1218;
  --fg: #eef2f6;
  --muted: #8b95a6;
  --surface: #161c25;
  --surface-2: #1e2632;
  --line: #2c3544;
  --up: #ff6b6b;
  --up-soft: #3a1e26;
  --down: #3ecb8e;
  --down-soft: #143028;
  --warn: #e8a33d;
  --warn-soft: #33260f;
  --brand: #e8665e;
  --brand-soft: #38201f;

  background: var(--bg);
  color: var(--fg);
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 浅色：整套变量换一遍，页面不用各写一份 */
.light {
  --bg: #f5f6f8;
  --fg: #1a1d23;
  --muted: #5e6779;
  --surface: #ffffff;
  --surface-2: #eef1f5;
  --line: #e3e7ee;
  --up: #c9202e;
  --up-soft: #fdecee;
  --down: #0b7040;
  --down-soft: #e7f6ef;
  --warn: #8f5c00;
  --warn-soft: #fdf1dc;
  --brand: #c62016;
  --brand-soft: #fdecea;
  background: var(--bg);
  color: var(--fg);
}

/* ── 通用 ── */
.wrap {
  padding: 24rpx 24rpx 120rpx;
}
.num {
  font-variant-numeric: tabular-nums;
}
.muted {
  color: var(--muted);
}
.up {
  color: var(--up);
}
.down {
  color: var(--down);
}
.warn {
  color: var(--warn);
}
.note-line {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.75;
  padding: 0 8rpx;
  margin: 16rpx 0;
}

/* ── 区块：1px 边框 + 6rpx 圆角，不加阴影 ── */
.panel {
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--surface);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.panel .hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
.panel .hd .t {
  font-size: 28rpx;
  font-weight: 500;
}
.panel .hd .n {
  font-size: 24rpx;
  color: var(--muted);
}
.panel .bd {
  padding: 24rpx 32rpx;
}

/* ── 结论区（首屏）── */
.verdict {
  padding: 48rpx 32rpx 40rpx;
  border-bottom: 1rpx solid var(--line);
}
.verdict .eyebrow {
  font-size: 24rpx;
  color: var(--muted);
}
.verdict .big {
  font-size: 72rpx;
  line-height: 1.1;
  font-weight: 500;
  margin-top: 16rpx;
}
.verdict .big .em {
  color: var(--warn);
}
.verdict .sub {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 24rpx;
  line-height: 1.8;
}
.gap {
  display: flex;
  flex-wrap: wrap;
  gap: 40rpx;
  margin-top: 40rpx;
}
.gap .k {
  font-size: 24rpx;
  color: var(--muted);
}
.gap .v {
  font-size: 48rpx;
  font-weight: 500;
  margin-top: 8rpx;
}
.gap .v text {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--muted);
}
.gap .h {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.meter {
  height: 12rpx;
  background: var(--surface-2);
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 40rpx;
}
.meter .fill {
  height: 100%;
  background: var(--warn);
  border-radius: 999rpx;
}

/* ── 样本墙：一格一笔 ── */
.wall {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.wall .cell {
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
}
.wall .open {
  border: 1rpx solid var(--line);
}
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 20rpx;
}
.legend .sw {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  vertical-align: -2rpx;
}

/* ── 状态标签 ── */
.pill {
  display: inline-block;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 24rpx;
}
.p-up {
  background: var(--up-soft);
  color: var(--up);
}
.p-down {
  background: var(--down-soft);
  color: var(--down);
}
.p-warn {
  background: var(--warn-soft);
  color: var(--warn);
}
.p-mute {
  background: var(--surface-2);
  color: var(--muted);
}

/* ── 概览格子 ── */
.tiles {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rpx;
  background: var(--line);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  overflow: hidden;
}
.tile {
  background: var(--surface);
  padding: 28rpx 32rpx;
}
.tile .k {
  font-size: 24rpx;
  color: var(--muted);
}
.tile .v {
  font-size: 48rpx;
  font-weight: 500;
  margin-top: 12rpx;
}
.tile .h {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 12rpx;
}

/* ── 日期分组（持仓）── */
.urgent {
  border-left: 4rpx solid var(--warn);
  padding-left: 28rpx;
}
.daygroup {
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--surface);
  margin-bottom: 24rpx;
}
.daygroup .hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 28rpx;
  background: var(--surface-2);
  font-size: 24rpx;
}
.daygroup .hd .d {
  font-weight: 500;
  font-size: 28rpx;
}

/* ── 列表行 ── */
.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid var(--line);
}
.row:first-child {
  border-top: 0;
}
.row .name {
  font-weight: 500;
}

/* ── 空 / 出错 ── */
.statebox {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 64rpx 40rpx;
  text-align: center;
}
.statebox .glyph {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  border: 1rpx solid currentColor;
}
.statebox .hint {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
}
